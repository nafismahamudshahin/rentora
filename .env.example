# Frontend env for Vercel.
# Copy these names into Vercel Project Settings → Environment Variables.

# This Next.js app's own URL. Better Auth calls same-origin /api/auth, which
# Next rewrites to the Express API. Use the final Vercel domain, no trailing /.
BETTER_AUTH_URL=https://your-frontend.vercel.app

# The deployed Express API, also with no trailing slash. Next rewrites every
# /api/* request here. Change this value and redeploy if the backend URL changes.
API_SERVER_URL=https://your-backend.vercel.app

# Needed because lib/auth.ts is imported during the Next build.
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
